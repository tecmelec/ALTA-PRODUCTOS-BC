# Copia estos nombres en Vercel → Project Settings → Environment Variables.
# NO rellenes valores reales aquí ni subas este archivo con datos reales.

BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ITEMS_ENTITY_URL=https://api.businesscentral.dynamics.com/v2.0/<TENANT_ID>/Production/ODataV4/Company('<EMPRESA>')/Items
BC_MANUFACTURERS_ENTITY_URL=https://api.businesscentral.dynamics.com/v2.0/<TENANT_ID>/Production/ODataV4/Company('<EMPRESA>')/Manufacturers
BC_ITEM_CATEGORIES_ENTITY_URL=https://api.businesscentral.dynamics.com/v2.0/<TENANT_ID>/Production/ODataV4/Company('<EMPRESA>')/ItemCategories
BC_DEFAULT_DIMENSIONS_ENTITY_URL=https://api.businesscentral.dynamics.com/v2.0/<TENANT_ID>/Production/ODataV4/Company('<EMPRESA>')/Dimensiones_predet
ALLOWED_ORIGIN=https://tecmelec.github.io

# Réplica de productos para listar/buscar todo el catálogo sin límite de tiempo
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para el cron semanal de sincronización completa (cualquier cadena
# aleatoria larga; Vercel la envía automáticamente en la cabecera Authorization
# cuando dispara el cron, y el propio backend la usa para encadenar tandas).
CRON_SECRET=

# Sugerencia de descripción de producto (busca en matmax.es / la web con
# Tavily, gratis y sin tarjeta, y Gemini solo redacta el resultado)
TAVILY_API_KEY=
GEMINI_API_KEY=
